<StateS Version="0.5.0">
    <Configuration>
        <ViewScale Value="0.835754"/>
        <ViewCentralPoint X="725.318" Y="367.187"/>
    </Configuration>
    <Machine Name="Burst emitter" Type="FSM">
        <Variables>
            <Input Name="Trigger" Type="Boolean" Value="FALSE"/>
            <Internal Name="period counter" Type="BitVector" Value="000" Memorized="true"/>
            <Internal Name="event counter" Type="BitVector" Value="000" Memorized="true"/>
            <Output Name="Burst" Type="Boolean" Value="FALSE"/>
            <Constant Name="period length" Type="BitVector" Value="011"/>
            <Constant Name="period count" Type="BitVector" Value="100"/>
        </Variables>
        <States>
            <State Name="Wait trig" IsInitial="true" X="151.5" Y="389.627"/>
            <State Name="Burst low" X="893.847" Y="671.024">
                <Actions>
                    <Action Name="event counter" ActionType="Increment"/>
                </Actions>
            </State>
            <State Name="Burst high" X="898.719" Y="151.5">
                <Actions>
                    <Action Name="Burst" ActionType="ActiveOnState"/>
                    <Action Name="event counter" ActionType="Increment"/>
                </Actions>
            </State>
        </States>
        <Transitions>
            <Transition Source="Wait trig" Target="Burst high">
                <Condition>
                    <LogicEquation Operator="identity">
                        <Operand Rank="0" Source="Variable" Name="Trigger"/>
                    </LogicEquation>
                </Condition>
            </Transition>
            <Transition Source="Burst high" Target="Burst low" SliderPos="76">
                <Condition>
                    <LogicEquation Operator="equals">
                        <Operand Rank="0" Source="Variable" Name="event counter"/>
                        <Operand Rank="1" Source="Variable" Name="period length"/>
                    </LogicEquation>
                </Condition>
                <Actions>
                    <Action Name="event counter" ActionType="Assign" ActionValueType="BitVector" ActionValue="000"/>
                </Actions>
            </Transition>
            <Transition Source="Burst low" Target="Burst high" SliderPos="76">
                <Condition>
                    <LogicEquation Operator="and" OperandCount="2">
                        <Operand Rank="0" Source="Equation">
                            <LogicEquation Operator="equals">
                                <Operand Rank="0" Source="Variable" Name="event counter"/>
                                <Operand Rank="1" Source="Variable" Name="period length"/>
                            </LogicEquation>
                        </Operand>
                        <Operand Rank="1" Source="Equation">
                            <LogicEquation Operator="differs">
                                <Operand Rank="0" Source="Variable" Name="period counter"/>
                                <Operand Rank="1" Source="Variable" Name="period count"/>
                            </LogicEquation>
                        </Operand>
                    </LogicEquation>
                </Condition>
                <Actions>
                    <Action Name="event counter" ActionType="Assign" ActionValueType="BitVector" ActionValue="000"/>
                    <Action Name="period counter" ActionType="Increment"/>
                </Actions>
            </Transition>
            <Transition Source="Burst low" Target="Wait trig" SliderPos="86">
                <Condition>
                    <LogicEquation Operator="and" OperandCount="2">
                        <Operand Rank="0" Source="Equation">
                            <LogicEquation Operator="equals">
                                <Operand Rank="0" Source="Variable" Name="event counter"/>
                                <Operand Rank="1" Source="Variable" Name="period length"/>
                            </LogicEquation>
                        </Operand>
                        <Operand Rank="1" Source="Equation">
                            <LogicEquation Operator="equals">
                                <Operand Rank="0" Source="Variable" Name="period counter"/>
                                <Operand Rank="1" Source="Variable" Name="period count"/>
                            </LogicEquation>
                        </Operand>
                    </LogicEquation>
                </Condition>
                <Actions>
